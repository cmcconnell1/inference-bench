ENGINE_NAME="tgi"
ENGINE_IMAGE="ghcr.io/huggingface/text-generation-inference:${TGI_TAG:-latest}"
ENGINE_PORT="80"
ENGINE_ENTRYPOINT=""
ENGINE_ARGS="--model-id ${MODEL} --port 80 --max-input-tokens $(( ${MAX_MODEL_LEN:-4096} - 512 )) --max-total-tokens ${MAX_MODEL_LEN:-4096} --max-batch-prefill-tokens ${MAX_MODEL_LEN:-4096} ${TGI_EXTRA_ARGS:-}"
ENGINE_ENV="-e HF_HUB_ENABLE_HF_TRANSFER=0"
ENGINE_HEALTH_PATH="/health"
ENGINE_MODEL_NAME="${MODEL}"
ENGINE_PRECISION="${PRECISION:-fp16/bf16 (auto)}"
ENGINE_POST_START=""
ENGINE_NOTES="OpenAI-compatible route is /v1/chat/completions. Model name in requests must be the HF id, not an alias."
