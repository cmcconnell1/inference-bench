ENGINE_NAME="vllm"
ENGINE_IMAGE="vllm/vllm-openai:${VLLM_TAG:-v0.11.0}"
ENGINE_PORT="8000"
ENGINE_ENTRYPOINT=""
ENGINE_ARGS="--model ${MODEL} --served-model-name bench --host 0.0.0.0 --port 8000 --max-model-len ${MAX_MODEL_LEN:-4096} --gpu-memory-utilization ${GPU_MEM_UTIL:-0.90} --dtype auto ${VLLM_EXTRA_ARGS:-}"
ENGINE_ENV="-e VLLM_LOGGING_LEVEL=INFO"
ENGINE_HEALTH_PATH="/health"
ENGINE_MODEL_NAME="bench"
ENGINE_PRECISION="${PRECISION:-fp16/bf16 (dtype auto)}"
ENGINE_POST_START=""
ENGINE_NOTES="Reference engine. Continuous batching, paged KV cache, prefix caching on by default."
