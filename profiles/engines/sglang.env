ENGINE_NAME="sglang"
ENGINE_IMAGE="lmsysorg/sglang:${SGLANG_TAG:-latest}"
ENGINE_PORT="8000"
ENGINE_ENTRYPOINT="python3"
ENGINE_ARGS="-m sglang.launch_server --model-path ${MODEL} --served-model-name bench --host 0.0.0.0 --port 8000 --context-length ${MAX_MODEL_LEN:-4096} --mem-fraction-static ${SGLANG_MEM_FRACTION:-0.85} ${SGLANG_EXTRA_ARGS:-}"
ENGINE_ENV=""
ENGINE_HEALTH_PATH="/health"
ENGINE_MODEL_NAME="bench"
ENGINE_PRECISION="${PRECISION:-fp16/bf16 (auto)}"
ENGINE_POST_START=""
ENGINE_NOTES="RadixAttention prefix cache. Pin SGLANG_TAG before a reportable run; the image digest is recorded in meta.json regardless."
