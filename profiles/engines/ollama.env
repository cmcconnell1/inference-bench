ENGINE_NAME="ollama"
ENGINE_IMAGE="ollama/ollama:${OLLAMA_TAG:-latest}"
ENGINE_PORT="11434"
ENGINE_ENTRYPOINT=""
ENGINE_ARGS=""
ENGINE_ENV="-e OLLAMA_HOST=0.0.0.0:11434 -e OLLAMA_NUM_PARALLEL=${OLLAMA_NUM_PARALLEL:-32} -e OLLAMA_KEEP_ALIVE=-1 -e OLLAMA_MAX_LOADED_MODELS=1 -e OLLAMA_FLASH_ATTENTION=1"
ENGINE_HEALTH_PATH="/api/tags"
ENGINE_MODEL_NAME="${OLLAMA_MODEL:-llama3.1:8b}"
ENGINE_PRECISION="${PRECISION:-Q4_K_M GGUF (Ollama default tag)}"
ENGINE_POST_START="docker exec bench-engine ollama pull ${OLLAMA_MODEL:-llama3.1:8b}"
ENGINE_NOTES="Developer tool, not a production server. Default tag is a 4-bit quant, so quality and memory differ from the FP16 engines. Included as the baseline people actually run on laptops."
