ENGINE_NAME="llamacpp"
ENGINE_IMAGE="ghcr.io/ggml-org/llama.cpp:${LLAMACPP_TAG:-server-cuda}"
ENGINE_PORT="8000"
ENGINE_ENTRYPOINT=""
ENGINE_ARGS="-hf ${LLAMACPP_HF_REPO:-bartowski/Meta-Llama-3.1-8B-Instruct-GGUF:Q8_0} --alias bench --host 0.0.0.0 --port 8000 -ngl 99 -c $(( ${MAX_MODEL_LEN:-4096} * ${LLAMACPP_PARALLEL:-8} )) -np ${LLAMACPP_PARALLEL:-8} --flash-attn on ${LLAMACPP_EXTRA_ARGS:-}"
ENGINE_ENV="-e LLAMA_CACHE=/root/.cache/huggingface/llamacpp"
ENGINE_HEALTH_PATH="/health"
ENGINE_MODEL_NAME="bench"
ENGINE_PRECISION="${PRECISION:-Q8_0 GGUF}"
ENGINE_POST_START=""
ENGINE_NOTES="GGUF quantized weights. -np sets parallel slots; context is split across slots, so -c is multiplied by -np."
