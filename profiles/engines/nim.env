ENGINE_NAME="nim"
ENGINE_IMAGE="nvcr.io/nim/meta/${NIM_MODEL_SLUG:-llama-3.1-8b-instruct}:${NIM_TAG:-latest}"
ENGINE_PORT="8000"
ENGINE_ENTRYPOINT=""
ENGINE_ARGS=""
ENGINE_ENV="-e NGC_API_KEY=${NGC_API_KEY:-} -e NIM_CACHE_PATH=/root/.cache/huggingface/nim ${NIM_EXTRA_ENV:-}"
ENGINE_HEALTH_PATH="/v1/health/ready"
ENGINE_MODEL_NAME="meta/${NIM_MODEL_SLUG:-llama-3.1-8b-instruct}"
ENGINE_PRECISION="${PRECISION:-NIM-selected TensorRT-LLM profile (fp16 or fp8 by GPU)}"
ENGINE_POST_START=""
ENGINE_NOTES="Requires NGC_API_KEY and docker login nvcr.io. NIM picks an optimized TensorRT-LLM profile per GPU; this is what Akamai's own Blackwell blog used. May not fit on a 20 GB GPU."
