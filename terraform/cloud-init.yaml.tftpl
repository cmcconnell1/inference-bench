#cloud-config
# Bootstraps an Ubuntu 24.04 GPU instance for serving-engine benchmarks.
# Phase 1 (this file): NVIDIA open kernel modules, Docker, NVIDIA Container
# Toolkit, guidellm in a venv, SSH hardening, then reboot to load the driver.
# Phase 2 (operator): bin/sync.sh copies the harness to /opt/bench.

package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - git
  - rsync
  - tmux
  - htop
  - ufw
  - fail2ban
  - build-essential
  - dkms
  - python3-venv
  - python3-pip

write_files:
  - path: /etc/ssh/sshd_config.d/99-bench-hardening.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
      X11Forwarding no
      AllowTcpForwarding local
      ClientAliveInterval 60
      ClientAliveCountMax 3

  - path: /opt/bench/env
    permissions: "0600"
    owner: root:root
    content: |
      # Populated by cloud-init from Terraform variables. Sourced by host scripts.
      HF_TOKEN=${hf_token}
      NGC_API_KEY=${ngc_api_key}
      BENCH_PLAN=${plan}
      BENCH_REGION=${region}
      HF_HOME=/var/lib/bench/hf-cache
      BENCH_RESULTS=/var/lib/bench/results

  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "3" }
      }

  - path: /usr/local/sbin/bench-bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Idempotent bootstrap. Logs to /var/log/bench-bootstrap.log.
      set -euo pipefail
      exec > >(tee -a /var/log/bench-bootstrap.log) 2>&1
      echo "[bootstrap] start $(date -u +%FT%TZ)"
      export DEBIAN_FRONTEND=noninteractive
      mkdir -p /var/lib/bench/hf-cache /var/lib/bench/results /opt/bench

      # Kernel headers for the running kernel (DKMS build of the NVIDIA module).
      apt-get install -y "linux-headers-$(uname -r)" || apt-get install -y linux-headers-generic

      # NVIDIA CUDA repository keyring, then the open kernel module meta-package.
      # nvidia-open covers Turing, Ada and Blackwell. Fallback to cuda-drivers.
      if ! dpkg -s cuda-keyring >/dev/null 2>&1; then
        curl -fsSL -o /tmp/cuda-keyring.deb \
          https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb
        dpkg -i /tmp/cuda-keyring.deb
        apt-get update
      fi
      if ! command -v nvidia-smi >/dev/null 2>&1; then
        apt-get install -y nvidia-open || apt-get install -y cuda-drivers
      fi

      # Docker CE from Docker's repository.
      if ! command -v docker >/dev/null 2>&1; then
        install -m 0755 -d /etc/apt/keyrings
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
        chmod a+r /etc/apt/keyrings/docker.asc
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
          > /etc/apt/sources.list.d/docker.list
        apt-get update
        apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      fi

      # NVIDIA Container Toolkit so containers can use --gpus all.
      if ! command -v nvidia-ctk >/dev/null 2>&1; then
        curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
        curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
          | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' \
          > /etc/apt/sources.list.d/nvidia-container-toolkit.list
        apt-get update
        apt-get install -y nvidia-container-toolkit
        nvidia-ctk runtime configure --runtime=docker
        systemctl restart docker
      fi

      # guidellm load generator in an isolated venv, exact version pinned.
      if [ ! -x /opt/bench/venv/bin/guidellm ]; then
        python3 -m venv /opt/bench/venv
        /opt/bench/venv/bin/pip install --upgrade pip
        /opt/bench/venv/bin/pip install "guidellm==${guidellm_version}"
      fi

      # Host firewall: SSH only. Engine ports bind to loopback.
      ufw allow OpenSSH
      ufw --force enable
      systemctl enable --now fail2ban

      echo "[bootstrap] complete $(date -u +%FT%TZ)"
      touch /var/lib/bench/bootstrap-complete

runcmd:
  - [ bash, -c, "/usr/local/sbin/bench-bootstrap.sh" ]
  - [ systemctl, restart, ssh ]

power_state:
  mode: reboot
  message: "Rebooting to load the NVIDIA kernel module"
  timeout: 60
  condition: true
