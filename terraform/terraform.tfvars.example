# Copy to terraform.tfvars (gitignored). Never commit tokens; LINODE_TOKEN,
# TF_VAR_hf_token and TF_VAR_ngc_api_key belong in the shell environment.

label               = "inference-bench"
region              = "us-ord"
plan                = "g2-gpu-rtx4000a1-s"
image               = "linode/ubuntu24.04"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Operator public IP. Find it with: curl -4 -s https://ifconfig.me
allowed_cidrs = ["203.0.113.10/32"]

expose_engine_port = false
guidellm_version   = "0.7.4"
